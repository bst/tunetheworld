<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Brand name, the same in every language -->
    <string name="app_title" translatable="false">Tune the World</string>
    <!-- Shorter name under the launcher icon, where long labels get cut off -->
    <string name="app_label" translatable="false">TuneWorld</string>
    <string name="settings">Settings</string>
    <string name="info_line">A4 = %1$d Hz · %2$s</string>
    <string name="reference_pitch">Reference pitch</string>
    <string name="reset_reference">Reset to 440 Hz</string>
    <string name="transposition">Transposition</string>
    <string name="transposition_hint">For transposing instruments, so the tuner shows the written note. Common values: +2 trumpet and clarinet in B♭, +7 horn in F, +9 alto sax, +12 guitar and double bass, +14 tenor sax, −12 piccolo.</string>
    <plurals name="semitones">
        <item quantity="one">%1$+d semitone</item>
        <item quantity="other">%1$+d semitones</item>
    </plurals>
    <string name="transposition_concert">Concert pitch</string>
    <!-- %1$s is the key, for example B♭, %2$+d the semitones, for example +14 -->
    <string name="transposition_short">in %1$s (%2$+d)</string>
    <string name="transposition_concert_hint">Shows the sounding note.</string>
    <!-- %1$s note name, %2$d octave, for example "B♭" and 2 -->
    <string name="written_c_sounds">A written C4 sounds as %1$s%2$d.</string>
    <string name="reset_transposition">Reset to concert pitch</string>
    <string name="sensitivity">Microphone sensitivity</string>
    <string name="sensitivity_hint">Move left for quiet instruments. Move right if background noise confuses the tuner. The marker on the level bar shows this threshold.</string>
    <string name="gate_format">Threshold: %1$d dB</string>
    <string name="level_ok">Signal heard</string>
    <string name="level_too_quiet">Too quiet</string>
    <string name="a11y_level">Input level %1$d decibels, threshold %2$d decibels</string>
    <string name="language">Language</string>
    <!-- Language names always appear in their own language -->
    <string name="language_de" translatable="false">Deutsch</string>
    <string name="language_en" translatable="false">English</string>
    <string name="no_note" translatable="false">–</string>
    <string name="hertz_format">%1$s Hz</string>
    <string name="hint_play">Play a note</string>
    <string name="too_low">flat</string>
    <string name="too_high">sharp</string>
    <string name="a11y_reading">%1$s %2$d, %3$+d percent</string>
    <string name="permission_title">Microphone needed</string>
    <string name="permission_text">The tuner listens to your instrument through the microphone. Nothing is recorded or sent.</string>
    <string name="permission_button">Allow microphone</string>
    <string name="open_settings">Open settings</string>
</resources>
