#!/bin/sh
# Blocks the push when a unit test fails.
# Enable once per clone with: git config core.hooksPath .githooks
# Skip in an emergency with: git push --no-verify

cd "$(git rev-parse --show-toplevel)" || exit 1

echo "pre-push: running unit tests..."
if ! ./gradlew -q :app:testDebugUnitTest; then
    echo "pre-push: tests failed, see app/build/reports/tests/testDebugUnitTest/index.html" >&2
    exit 1
fi
