#!/bin/sh
# Blocks the commit when ktlint or Android lint reports a problem.
# Enable once per clone with: git config core.hooksPath .githooks
# Skip in an emergency with: git commit --no-verify

cd "$(git rev-parse --show-toplevel)" || exit 1

echo "pre-commit: running ktlint..."
if ! ./gradlew -q :app:ktlintCheck; then
    echo "pre-commit: ktlint failed, fix with ./gradlew ktlintFormat" >&2
    exit 1
fi

echo "pre-commit: running Android lint..."
if ! ./gradlew -q :app:lintDebug; then
    echo "pre-commit: lint failed, see app/build/reports/lint-results-debug.html" >&2
    exit 1
fi
